# Demo del teclado en la DE0-Nano. Verifiquen los pines con el manual.
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE22F17C6
set_global_assignment -name TOP_LEVEL_ENTITY demo_teclado
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name VHDL_FILE demo_teclado.vhd
set_global_assignment -name VHDL_FILE ../plantilla/barrido_teclado.vhd
set_global_assignment -name VHDL_FILE ../plantilla/teclado_4x4.vhd
# Archivos de la clase 1 (terminados) y bloques de apoyo:
set_global_assignment -name VHDL_FILE ../../clase1_registros/plantilla/sincronizador.vhd
set_global_assignment -name VHDL_FILE ../../clase1_registros/plantilla/reset_sync.vhd
set_global_assignment -name VHDL_FILE ../../clase1_registros/plantilla/detector_flanco.vhd
set_global_assignment -name VHDL_FILE ../apoyo/base_tiempo.vhd
set_global_assignment -name VHDL_FILE ../plantilla/antirrebote.vhd
set_location_assignment PIN_R8  -to clk
set_location_assignment PIN_J15 -to rst_n
set_location_assignment PIN_A15 -to led[0]
set_location_assignment PIN_A13 -to led[1]
set_location_assignment PIN_B13 -to led[2]
set_location_assignment PIN_A11 -to led[3]
set_location_assignment PIN_D1  -to led[4]
set_location_assignment PIN_F3  -to led[5]
set_location_assignment PIN_B1  -to led[6]
set_location_assignment PIN_L3  -to led[7]
# Teclado en GPIO_1 (conector JP2): filas = pines 4,5,6,7 ; columnas = pines 8,9,10,13 (igual que en el proyecto)
set_location_assignment PIN_T15 -to filas[0]
set_location_assignment PIN_T14 -to filas[1]
set_location_assignment PIN_T13 -to filas[2]
set_location_assignment PIN_R13 -to filas[3]
set_location_assignment PIN_T12 -to columnas[0]
set_location_assignment PIN_R12 -to columnas[1]
set_location_assignment PIN_T11 -to columnas[2]
set_location_assignment PIN_T10 -to columnas[3]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to columnas[0]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to columnas[1]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to columnas[2]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to columnas[3]
